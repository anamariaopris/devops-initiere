{
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;database=online_school_db;user=root;password=root"
  },
  "Jwt": {
    "Secret": "b25saW5lLXNjaG9vbC1jbG91ZC1hcGktc3VwZXItc2VjdXJlLWp3dC1zZWNyZXQtbXVzdC1iZS1sb25nLWVub3VnaA==",
    "ExpirationSeconds": 86400
  },
  "Security": {
    "PasswordEncoderStrength": 10,
    "PublicPaths": [
      "/auth/register",
      "/auth/login",
      "/error",
      "/swagger/**"
    ],
    "ResourceRules": [
      { "PathPattern": "/students/**", "ReadAuthority": "student:read", "WriteAuthority": "student:write" },
      { "PathPattern": "/teachers/**", "ReadAuthority": "teacher:read", "WriteAuthority": "teacher:write" },
      { "PathPattern": "/administrators/**", "ReadAuthority": "administrator:read", "WriteAuthority": "administrator:write" },
      { "PathPattern": "/courses/**", "ReadAuthority": "course:read", "WriteAuthority": "course:write" },
      { "PathPattern": "/books/**", "ReadAuthority": "book:read", "WriteAuthority": "book:write" },
      { "PathPattern": "/enrolments/**", "ReadAuthority": "enrolment:read", "WriteAuthority": "enrolment:write" },
      { "PathPattern": "/users/**", "ReadAuthority": "user:read", "WriteAuthority": "user:write" },
      { "PathPattern": "/permissions/**", "ReadAuthority": "permission:read", "WriteAuthority": "permission:write" },
      { "PathPattern": "/dashboard/**", "ReadAuthority": "dashboard:read", "WriteAuthority": "dashboard:write" },
      { "PathPattern": "/reports/**", "ReadAuthority": "report:read", "WriteAuthority": "report:write" },
      { "PathPattern": "/settings/**", "ReadAuthority": "settings:read", "WriteAuthority": "settings:write" }
    ]
  },
  "Cors": {
    "AllowedOriginPatterns": [
      "http://localhost:*",
      "https://localhost:*",
      "http://127.0.0.1:*",
      "https://127.0.0.1:*",
      "http://0.0.0.0:*",
      "https://0.0.0.0:*",
      "http://[::1]:*",
      "https://[::1]:*",
      "https://*.vercel.app",
      "https://*.netlify.app",
      "https://*.web.app",
      "https://*.firebaseapp.com",
      "https://*.pages.dev",
      "https://*.githubpreview.dev",
      "https://*.gitpod.io",
      "https://*.codespaces.github.com"
    ],
    "AdditionalOrigins": "",
    "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Authorization", "Content-Type", "Accept", "Origin", "X-Requested-With", "Cache-Control" ],
    "ExposedHeaders": [ "Authorization", "Content-Disposition" ],
    "AllowCredentials": true,
    "MaxAgeSeconds": 3600
  },
  "Docs": {
    "Title": "Online School Cloud API",
    "Version": "v1",
    "Description": "JWT secured API for managing students, teachers, administrators, courses, books and enrolments.",
    "BearerSchemeName": "bearerAuth",
    "DefaultPassword": "password",
    "BootstrapUsers": [
      "admin@online-school.ro",
      "andrei.ionescu@online-school.ro",
      "ana.marinescu@student.online-school.ro"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Cors": "Information"
    }
  },
  "AllowedHosts": "*"
}
